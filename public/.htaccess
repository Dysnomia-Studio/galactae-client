RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !(.*)\.(css|jpg|png|gif|svg|js|ttf|ico|mp3|map|xml)$
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

# Errors
ErrorDocument 401 ../errors/401.html
ErrorDocument 403 ../errors/403.html
ErrorDocument 404 ../errors/404.html
ErrorDocument 408 ../errors/time_out.html
ErrorDocument 504 ../errors/time_out.html

<FilesMatch "\.(css|jpg|png|gif|svg|js|ttf|ico|mp3|map|xml)$">
  FileETag None
  <IfModule mod_headers.c>
    Header unset ETag
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 12 Jan 1980 05:00:00 GMT"
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
	Header set Access-Control-Allow-Origin "*.galactae.eu"
</IfModule>