RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !(.*)\.(css|jpg|png|gif|js|ttf|ico|mp3)$
RewriteRule ^(.*)$ index.php [L]

# Client Cache
<ifmodule mod_expires.c>
	<Filesmatch "\.(jpg|jpeg|png|gif|js|css|swf|ico|woff|mp3)$">
	    ExpiresActive on
	    ExpiresDefault "access plus 0 seconds"
	</Filesmatch>
</ifmodule>